# Copy to .dev.vars for local development. Never commit .dev.vars.
# Local origins (override the production values in wrangler.toml):
APP_ORIGIN=http://localhost:8787
SITE_ORIGIN=http://localhost:8765
ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
DVLA_API_KEY=
# Phone notifications (Web Push): generate with node scripts/vapid-keys.mjs --env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
