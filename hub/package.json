{
  "name": "curve-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply curve-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply curve-hub --remote",
    "create-user": "node scripts/create-user.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "verify": "bash scripts/verify.sh",
    "check": "npm run typecheck && npm test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.3"
  }
}
